# Ay Parçası — canlı sunucu ayarları.
# Bu dosyayı sunucuda .env adıyla kopyalayın ve doldurun.
# .env asla git'e girmez (bkz. .gitignore) — deploy da üzerine yazmaz.

APP_NAME="Ay Parçası"
APP_ENV=production
# SSH olmadan `artisan key:generate` çalıştırılamıyor; anahtar yerelde
# üretilip buraya yapıştırılır. SONRADAN DEĞİŞTİRMEYİN — şifrelenmiş
# oturum verileri okunamaz hâle gelir.
APP_KEY=
APP_DEBUG=false
APP_URL=https://ayparcasicicekci.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# KKTC saati. Europe/Istanbul ya da Europe/Nicosia KULLANMAYIN.
APP_TIMEZONE=Asia/Famagusta

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# cPanel → MySQL Veritabanları'nda oluşturduğunuz bilgiler
DB_CONNECTION=mysql
# cPanel kullanıcıyı 'kullanici'@'localhost' olarak açar. 127.0.0.1 yazarsanız
# PHP TCP ile bağlanır ve MySQL bunu BAŞKA bir kimlik sayıp reddeder
# ("Access denied ... @'127.0.0.1'"), parola doğru olsa bile. localhost soket
# kullanır ve verilen yetkiyle eşleşir.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kullanici_ayparcasi
DB_USERNAME=kullanici_ayparcasi
DB_PASSWORD=

# Yüklenen görsellerin yazılacağı klasör. Bu pakette uygulama public_html
# içinde durduğu ve web kökündeki `storage` sembolik bağı takip edilmediği
# için dosyalar doğrudan web'in gördüğü yere yazılıyor.
FILESYSTEM_PUBLIC_ROOT=/home/aypa8479/public_html/storage

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# cPanel → E-posta Hesapları'nda açtığınız kutu
MAIL_MAILER=smtp
MAIL_HOST=mail.ayparcasicicekci.com
MAIL_PORT=465
MAIL_USERNAME=merhaba@ayparcasicicekci.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=merhaba@ayparcasicicekci.com
MAIL_FROM_NAME="${APP_NAME}"

# Tiko sanal POS. Kimlik bilgileri gelene kadar TIKO_ENABLED=false kalsın;
# o hâlde kasada havale ve kapıda ödeme çalışır, kartlı ödeme görünmez.
TIKO_ENABLED=false
TIKO_TEST_MODE=false
TIKO_MERCHANT_ID=
TIKO_API_KEY=
TIKO_SECRET=

SHOP_WHATSAPP=905488000000

# Yönetici hesabı ilk deploy'da bu bilgilerden açılır (parola en az 10
# karakter). Hesap zaten varsa dokunulmaz. Panele girdikten sonra
# ADMIN_PASSWORD satırını SİLİN.
ADMIN_NAME="Yönetici"
ADMIN_EMAIL=
ADMIN_PASSWORD=
